# ── Obligatorias ─────────────────────────────────────────────
# En Railway: referencia la variable del servicio MySQL → ${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://root:password@localhost:3306/potted
# Cadena larga y aleatoria para firmar las sesiones del panel
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Primer usuario administrador (se crea solo en el primer arranque)
ADMIN_EMAIL=admin@pottedusa.com
ADMIN_PASSWORD=cambia-esta-clave

# ── PayPal (para cobrar en línea) ────────────────────────────
# Crea una app en developer.paypal.com → Apps & Credentials.
# Usa las credenciales "Sandbox" para probar y las "Live" para cobrar de verdad.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# ── Opcionales ───────────────────────────────────────────────
# URL pública del sitio (enlaces de los correos, sitemap, canonical)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Cloudflare R2 para imágenes y PDF. Si se dejan vacías, se guardan en la
# base de datos (funciona, pero R2 es lo recomendado).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Resend para los correos de pedido y de formularios.
RESEND_API_KEY=
EMAIL_FROM=PotTed <orders@pottedusa.com>

# Sitio anterior en WordPress (para Panel → Importar)
WP_SOURCE_URL=https://pottedusa.com

# Pon "false" para arrancar sin el catálogo inicial
SEED_DEMO=true
